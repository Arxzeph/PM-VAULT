{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PM",
  "version": "0.1.0",
  "identifier": "com.antigravity.pm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PM — Personal Password Manager",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Zero-Knowledge Personal Password Manager",
    "longDescription": "Client-side encrypted local-first password manager with real-time cloud sync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
